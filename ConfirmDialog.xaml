<Window x:Class="Timesheet.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Timesheet"
        xmlns:conv="clr-namespace:Timesheet.Converters"
        mc:Ignorable="d"
        Title="ConfirmDialog" Height="175" Width="400" ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Grid VerticalAlignment="Center" Margin="20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Image Stretch="Uniform" MaxHeight="30" Grid.Column="1" Margin="0,0,5,0">
                <Image.Source>
                    <Binding ConverterParameter="{x:Static MessageBoxImage.Exclamation}">
                        <Binding.Converter>
                            <conv:MessageBoxIconConverter/>
                        </Binding.Converter>
                    </Binding>
                </Image.Source>
            </Image>
            <Label Content="Placeholder text for confirmation message" Grid.Column="2" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Background="#19000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                <Button x:Name="Okay" Content="Okay" Padding="5,0" IsDefault="True"/>
                <Button x:Name="Cancel" Content="Cancel" Padding="5,0" Margin="5,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
