<Window x:Class="Timesheet.EntryDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Timesheet"
        mc:Ignorable="d"
        Title="EntryDetailsDialog"
        Height="350" Width="400"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=EntryName}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Content="_Entry Name:" Target="{Binding ElementName=EntryName, Mode=OneWay}"/>
                    <TextBox x:Name="EntryName" Margin="5,0,0,0" Grid.Column="1"/>
                </Grid>
                <Label Content="_Details:" Target="{Binding ElementName=EntryDetails, Mode=OneWay}" Margin="0,5,0,0"/>
            </StackPanel>
            <TextBox x:Name="EntryDetails" Grid.Row="1"/>
            <StackPanel Grid.Row="2" Margin="0,5,0,0">
                <StackPanel Orientation="Horizontal">
                    <Label Content="Start:"/>
                    <TextBlock Text="???" Margin="5,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="End:"/>
                    <TextBlock Text="???" Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Background="#19000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                <Button x:Name="Okay" Content="Okay" Padding="5,0" IsDefault="True"/>
                <Button x:Name="Cancel" Content="Cancel" Padding="5,0" Margin="5,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
