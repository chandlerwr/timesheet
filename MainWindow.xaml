<Window x:Class="Timesheet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Timesheet"
        xmlns:vm="clr-namespace:Timesheet.ViewModel"
        d:DataContext="{d:DesignInstance vm:AppVM, IsDesignTimeCreatable=True}"
        mc:Ignorable="d"
        Title="Timesheet" Height="500" Width="500" MinWidth="350" MinHeight="400">
    <Grid>

        <!-- Overall application layout -->
        <DockPanel>

            <Grid DockPanel.Dock="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="1"/>
                </Grid.RowDefinitions>
            
                <!-- Project selection -->
                <DockPanel Grid.Row="0" Margin="5,0">

                    <Label Content="_Project:" 
                       VerticalAlignment="Center" DockPanel.Dock="Left" 
                       Target="{Binding ElementName=Project, Mode=OneWay}"/>

                    <Button x:Name="ProjectDelete" Content="&#215;" 
                            VerticalAlignment="Center" DockPanel.Dock="Right" 
                            Width="20"
                            ToolTip="Delete Project"
                            Click="ProjectDeleteClick"/>

                    <Button x:Name="ProjectImport" Content="&#x1F817;"
                            VerticalAlignment="Center" DockPanel.Dock="Right" 
                            Width="20"
                            Margin="0,0,5,0"
                            ToolTip="Import Project"
                            Click="ProjectImportClick"/>

                    <Button x:Name="ProjectExport" Content="&#x1F815;" 
                            VerticalAlignment="Center" DockPanel.Dock="Right" 
                            Width="20"
                            Margin="0,0,5,0"
                            ToolTip="Export Project"
                            Click="ProjectExportClick"/>

                    <Button x:Name="ProjectAdd" Content="+" 
                            VerticalAlignment="Center" DockPanel.Dock="Right" 
                            Width="20"
                            Margin="0,0,5,0"
                            ToolTip="New Project"
                            Click="ProjectAddClick"/>

                    <ComboBox x:Name="Project" 
                              VerticalAlignment="Center" 
                              Height="20"
                              Margin="5,0"
                              ToolTip="Select Project"
                              ItemsSource="{Binding Projects}"
                              SelectedItem="{Binding CurrentProject, Mode=TwoWay}"
                              DisplayMemberPath="Name"/>

                </DockPanel>

                <Separator Grid.Row="1" Height="1" Margin="0"/>
            </Grid>

            <!-- Selected items (project/timesheet entry) information -->
            <StatusBar DockPanel.Dock="Bottom" Height="20"/>

            <!-- Everything except project selector -->
            <Grid Margin="5,0,5,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <!-- Margins -->
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Project details/settings -->
                <Grid Margin="0,5,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Project details -->
                    <GroupBox Header="Project Details" Padding="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Project description -->
                            <Label Content="_Description:" Grid.Row="0" Target="{Binding ElementName=ProjectDescription, Mode=OneWay}"/>
                            <TextBox x:Name="ProjectDescription" Margin="0,5,0,0" Grid.Row="1"/>

                            <StackPanel Grid.Row="2" Margin="0,5,0,0">

                                <!-- Project stats -->
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Total entries:" Margin="0,0,5,0"/>
                                    <Label Content="8"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Total hours:" Margin="0,0,5,0"/>
                                    <Label Content="5.5"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Total work days/weeks:" Margin="0,0,5,0"/>
                                    <Label Content="- / -"/>
                                </StackPanel>

                                <Button x:Name="Rename" Content="Rename Project" HorizontalAlignment="Right" Padding="5,0" Margin="0,5,0,0"/>

                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Settings -->
                    <GroupBox Header="Settings" Padding="5" Grid.Row="1" Margin="0,5,0,0">
                        <StackPanel>

                            <CheckBox x:Name="TaskbarIconSetting" Content="Show in taskbar"/>
                            <CheckBox x:Name="TaskbarAnimationSetting" 
                                      Content="Animate in taskbar"
                                      Margin="0,5,0,0"
                                      IsEnabled="{Binding IsChecked, ElementName=TaskbarIconSetting, Mode=OneWay}"/>

                        </StackPanel>
                    </GroupBox>
                </Grid>

                <!-- Time sheet -->
                <DockPanel Grid.Column="2">

                    <DockPanel DockPanel.Dock="Top" Height="30">

                        <Button x:Name="TimesheetDelete" Content="&#215;" 
                                VerticalAlignment="Center" DockPanel.Dock="Right" 
                                Width="20"
                                ToolTip="Delete Entry"
                                Click="TimesheetDeleteClick"/>

                        <Button x:Name="TimesheetImport" Content="&#x1F817;" 
                                VerticalAlignment="Center" DockPanel.Dock="Right" 
                                Width="20"
                                ToolTip="Import Entry"
                                Margin="0,0,5,0"
                                Click="TimesheetImportClick"/>

                        <Button x:Name="TimesheetExport" Content="&#x1F815;" 
                                VerticalAlignment="Center" DockPanel.Dock="Right" 
                                Width="20"
                                ToolTip="Export Entry"
                                Margin="0,0,5,0"
                                Click="TimesheetExportClick"/>

                        <Button x:Name="TimesheetRecord" Content="&#x23F2;" 
                                VerticalAlignment="Center" DockPanel.Dock="Right" 
                                Width="20"
                                ToolTip="Record Entry"
                                Margin="0,0,5,0"
                                Click="TimesheetRecordClick"/>

                        <Label Content="_Timesheet:" 
                               VerticalAlignment="Center" 
                               Target="{Binding ElementName=Timesheet, Mode=OneWay}"/>

                    </DockPanel>

                    <ListBox x:Name="Timesheet" 
                             DockPanel.Dock="Bottom" 
                             AlternationCount="2" SelectionMode="Extended" 
                             HorizontalContentAlignment="Stretch" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <!-- Make list visually interesting with alternating colors -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <EventSetter Event="MouseDoubleClick" Handler="TimesheetItemMouseDoubleClick"/>
                                <Style.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                        <Setter Property="Background" Value="#19FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="#19000000"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <!-- Format for displaying timesheet entries -->
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.5*"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Dates}" 
                                               Grid.Row="0" Grid.Column="0" 
                                               VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding Description}" 
                                               Grid.Row="1" Grid.Column="0"  
                                               VerticalAlignment="Center" 
                                               TextWrapping="WrapWithOverflow" 
                                               Margin="0,0,5,0"/>

                                    <TextBlock Text="{Binding Duration}" 
                                               Grid.Column="1" Grid.RowSpan="2" 
                                               VerticalAlignment="Center"/>

                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
