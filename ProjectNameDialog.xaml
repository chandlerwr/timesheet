<Window x:Class="Timesheet.ProjectNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Timesheet"
        mc:Ignorable="d"
        Title="ProjectNameDialog"
        Height="175" Width="400"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=ProjectName}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        
        <Grid VerticalAlignment="Center" Margin="20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Content="_Project Name:" Target="{Binding ElementName=ProjectName, Mode=OneWay}"/>
            <TextBox x:Name="ProjectName" Grid.Column="1" Margin="5,0,0,0"/>
        </Grid>

        <Grid Grid.Row="1" Background="#19000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                <Button x:Name="Okay" Content="Okay" Padding="5,0" IsDefault="True"/>
                <Button x:Name="Cancel" Content="Cancel" Padding="5,0" Margin="5,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
